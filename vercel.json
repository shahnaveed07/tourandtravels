{
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "bittkashmir.in"
        }
      ],
      "destination": "https://www.bittkashmir.in/$1",
      "statusCode": 308
    }
  ],
  "rewrites": [
    {
      "source": "/((?!images/|assets/|sitemap\\.xml|robots\\.txt|CNAME|favicon\\.svg|404\\.html|googlefea446053fa36602\\.html).*)",
      "destination": "/index.html"
    }
  ]
}
